# /etc/systemd/system/htfarms-backup.service — nightly database + media backup (deploy/remote/backup.sh).
[Unit]
Description=H&T Farms backup
After=mysql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=DEPLOY_PATH=/var/www/htfarms
Environment=BACKUP_DIR=/var/backups/htfarms
Environment=BACKUP_RETENTION_DAYS=14
# Environment=BACKUP_RCLONE_REMOTE=b2:htfarms-backups
ExecStart=/var/www/htfarms/bin/backup.sh
Nice=15
IOSchedulingClass=idle
