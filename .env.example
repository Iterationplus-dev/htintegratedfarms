# -----------------------------------------------------------------------------
# H & T Integrated Farms — environment template.
# Copy to .env for local development. Production values live ONLY in
# /var/www/htfarms/shared/.env on the server (see docs/DEPLOYMENT.md).
# Full reference: docs/ENVIRONMENT.md
# -----------------------------------------------------------------------------

APP_NAME="H & T Integrated Farms"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://htintegratedfarms.test
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-* headers are trusted (e.g. Cloudflare). Empty = none.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default is SQLite. Production uses MySQL 8.4:
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=htfarms
#   DB_USERNAME=htfarms
#   DB_PASSWORD=change-me
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
# Production: redis (requires php-redis). Local default: database.
QUEUE_CONNECTION=database
QUEUE_CONVERSIONS_BY_DEFAULT=true

CACHE_STORE=database
CACHE_PREFIX=htfarms_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: "log" writes mail to storage/logs. Production: smtp with your provider's credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@htintegratedfarms.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Enquiries -----------------------------------------------------------------
# Fallback recipients for new-enquiry alerts (comma-separated). Admin → Settings overrides this.
ENQUIRY_NOTIFICATION_EMAIL=info@htintegratedfarms.com
# DNS check on submitted email addresses (email:rfc,dns). Keep true in production.
ENQUIRY_VERIFY_EMAIL_DNS=true
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_LIMIT_DECAY=600
ENQUIRY_MIN_FILL_SECONDS=3
# none | turnstile
ENQUIRY_CAPTCHA=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
QUOTE_DRAFT_LIFETIME_DAYS=14

# --- Analytics (loaded only after visitor consent) ------------------------------
# none | plausible | ga4
ANALYTICS_PROVIDER=none
# Plausible: site domain (htintegratedfarms.com). GA4: measurement ID (G-XXXXXXX).
ANALYTICS_ID=
ANALYTICS_SCRIPT_SRC=

VITE_APP_NAME="${APP_NAME}"
